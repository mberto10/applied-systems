{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attention Diet memory record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "attention-summary/1.0"
    },
    "version_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "previous_version": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        }
      ]
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "account_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemVersion",
        "properties": {
          "slot": {
            "enum": [
              "serendipity"
            ]
          },
          "topic": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 60
          }
        },
        "dependentRequired": {
          "slot": [
            "topic"
          ],
          "topic": [
            "slot"
          ]
        },
        "unevaluatedProperties": false
      },
      "uniqueItems": true
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    }
  },
  "required": [
    "schema_version",
    "version_id",
    "previous_version",
    "contract_id",
    "contract_revision",
    "account_key",
    "created_at",
    "items",
    "coverage",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "itemVersion": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "change_fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fingerprint_method": {
          "enum": [
            "incoming-id/v1",
            "sender-text/v1",
            "sender-text-time/v1"
          ]
        },
        "source_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "service",
        "identifier",
        "change_fingerprint"
      ]
    }
  },
  "description": "A saved version summary of included items. The wire format remains attention-summary/1.0."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attention Diet contract",
  "description": "Runtime and editor schema for attention contracts. Python adds relationships such as surface scope, service budgets and revision steps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "intent",
    "coverage_threads",
    "memory_context",
    "run_limits",
    "composition",
    "execution"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "memoryContext": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "local",
            "supermemory"
          ]
        },
        "purpose": {
          "const": "avoid_repeating_previously_briefed_items"
        },
        "on_unavailable": {
          "const": "continue_with_notice"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(\\/|~/)"
        },
        "space": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "provider",
        "purpose",
        "on_unavailable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": [
              "directory"
            ],
            "not": {
              "required": [
                "space"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "supermemory"
              }
            }
          },
          "then": {
            "required": [
              "space"
            ],
            "not": {
              "required": [
                "directory"
              ]
            }
          }
        }
      ]
    },
    "memoryScope": {
      "description": "Contract fields required to read historical memory, including older contract schema revisions.",
      "type": "object",
      "required": [
        "id",
        "revision",
        "memory_context"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/count"
        },
        "previous_ids": {
          "$ref": "#/properties/previous_ids"
        },
        "memory_context": {
          "$ref": "#/$defs/memoryContext"
        }
      }
    },
    "browserAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "session",
        "external_session_reuse",
        "fallback"
      ],
      "properties": {
        "type": {
          "const": "browser"
        },
        "provider": {
          "enum": [
            "host_default",
            "codex_in_app",
            "claude_browser",
            "agent_browser"
          ]
        },
        "session": {
          "const": "isolated"
        },
        "external_session_reuse": {
          "const": false
        },
        "fallback": {
          "const": "none"
        }
      }
    },
    "connectorAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tool_namespace",
        "fallback"
      ],
      "properties": {
        "type": {
          "const": "connector"
        },
        "tool_namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:/-]*$"
        },
        "connection_id": {
          "$ref": "#/$defs/text"
        },
        "fallback": {
          "const": "none"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "attention-diet-contract/1.3"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "previous_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "description": "Earlier ids whose briefing history this contract continues."
    },
    "revision": {
      "$ref": "#/$defs/count"
    },
    "intent": {
      "type": "object",
      "required": [
        "purpose",
        "success"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "success": {
          "$ref": "#/$defs/text"
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "focus"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "focus": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "coverage_threads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "service",
          "access",
          "account_actions",
          "surfaces",
          "selection",
          "on_access_failure",
          "procedure"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "service": {
            "$ref": "#/$defs/slug"
          },
          "access": {
            "oneOf": [
              {
                "$ref": "#/$defs/browserAccess"
              },
              {
                "$ref": "#/$defs/connectorAccess"
              }
            ]
          },
          "external_session_reuse": false,
          "account_actions": {
            "enum": [
              "none"
            ],
            "description": "Hard limit: read-only."
          },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "excluded_surfaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "entry_urls": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^https://",
              "format": "uri"
            }
          },
          "selection": {
            "type": "object",
            "minProperties": 1
          },
          "limits": {
            "type": "object",
            "properties": {
              "policy": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "$ref": "#/$defs/positive"
            }
          },
          "on_access_failure": {
            "$ref": "#/$defs/text"
          },
          "content": {
            "enum": [
              "private_communication",
              "public_posts"
            ],
            "description": "Unmarked threads count as private. Only public_posts entries may be shown without an identified account."
          },
          "expected_account": {
            "$ref": "#/$defs/text",
            "description": "The sign-in this contract expects for the service. A different observed account makes the source unavailable."
          },
          "procedure": {
            "type": "object",
            "required": [
              "account_identity",
              "read_state",
              "item_identity",
              "pagination"
            ],
            "additionalProperties": false,
            "properties": {
              "navigation": {
                "$ref": "#/$defs/text"
              },
              "account_identity": {
                "$ref": "#/$defs/text"
              },
              "read_state": {
                "$ref": "#/$defs/text"
              },
              "item_identity": {
                "$ref": "#/$defs/text"
              },
              "pagination": {
                "$ref": "#/$defs/text"
              },
              "retrieval": {
                "$ref": "#/$defs/text"
              }
            },
            "description": "Source instructions for identity, state effects, item identity, pagination, and either browser navigation or connector retrieval."
          },
          "collection": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "mode"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "scan",
                    "sample"
                  ]
                },
                "max_items": {
                  "$ref": "#/$defs/count"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "sample"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "max_items"
                    ]
                  }
                }
              ]
            }
          },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope"
              ],
              "properties": {
                "scope": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "access": {
                  "properties": {
                    "type": {
                      "const": "browser"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "entry_urls"
              ],
              "properties": {
                "targets": false,
                "procedure": {
                  "required": [
                    "navigation"
                  ],
                  "properties": {
                    "retrieval": false
                  }
                }
              }
            },
            "else": {
              "required": [
                "targets"
              ],
              "properties": {
                "entry_urls": false,
                "procedure": {
                  "required": [
                    "retrieval"
                  ],
                  "properties": {
                    "navigation": false
                  }
                }
              }
            }
          }
        ]
      }
    },
    "memory_context": {
      "$ref": "#/$defs/memoryContext"
    },
    "run_limits": {
      "type": "object",
      "required": [
        "elapsed_minutes"
      ],
      "properties": {
        "elapsed_minutes": {
          "$ref": "#/$defs/positive"
        },
        "items_per_surface": {
          "$ref": "#/$defs/count"
        },
        "service_minutes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/positive"
          }
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "interface",
        "delivery",
        "template",
        "template_path_base",
        "sections",
        "target_reading_minutes"
      ],
      "properties": {
        "interface": {
          "enum": [
            "agent_summary",
            "briefing_html",
            "discovery_html"
          ]
        },
        "delivery": {
          "enum": [
            "current_agent_conversation"
          ]
        },
        "template": {
          "$ref": "#/$defs/text"
        },
        "template_path_base": {
          "enum": [
            "plugin_root",
            "contract_dir"
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "target_reading_minutes": {
          "$ref": "#/$defs/positive"
        },
        "max_items_by_thread": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        },
        "format": {
          "$ref": "#/$defs/text"
        },
        "counts": {
          "$ref": "#/$defs/text"
        },
        "overflow": {
          "$ref": "#/$defs/text"
        },
        "no_new_items": {
          "$ref": "#/$defs/text"
        },
        "item_format": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "schedule_enabled"
      ],
      "properties": {
        "mode": {
          "enum": [
            "one_off_on_invocation"
          ]
        },
        "schedule_enabled": {
          "const": false,
          "description": "Hard limit until scheduling is designed."
        },
        "daily_time": {
          "const": null,
          "description": "Reserved; scheduling is disabled."
        },
        "parallelism": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "max_workers"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "when_independent"
              ]
            },
            "max_workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          },
          "description": "Permission for parallel collection. With when_independent, a host that can start subagents may read one source service per collector at the same time, all capturing into one run. Omission or off keeps sequential collection, which is also the fallback."
        }
      },
      "additionalProperties": false
    },
    "serendipity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_items",
        "sources"
      ],
      "description": "A capped, labelled slot for one substantive item outside every listed interest. Grants no extra access.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/\\S+$"
          },
          "description": "thread-id/surface pairs already configured in coverage_threads."
        },
        "share_of_discovery_sample": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "avoid_repeating_topics_for_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
